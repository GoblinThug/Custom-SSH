{
  "name": "custom_ssh",
  "version": "3.7.0",
  "description": "Desktop SSH client for Windows, macOS and Linux — terminal, SFTP, editor, saved connections",
  "author": "Goblin_Thug",
  "main": "dist-electron/main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/GoblinThug/Custom-SSH.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:mac:dir": "npm run build && electron-builder --mac --dir",
    "dist:linux:dir": "npm run build && electron-builder --linux --dir",
    "dist:publish": "npm run build && electron-builder --win --publish always",
    "dist:publish:mac": "npm run build && electron-builder --mac --publish always",
    "dist:publish:linux": "npm run build && electron-builder --linux --publish always",
    "icons": "node scripts/make-icon-ico.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.16.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ssh2": "^1.15.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.2",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.goblinthug.customssh",
    "productName": "Custom SSH",
    "executableName": "CustomSSH",
    "copyright": "Copyright © Goblin_Thug",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ssh2/**/*",
      "**/node_modules/cpu-features/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "CustomSSH-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "CustomSSH-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Goblin_Thug",
      "synopsis": "SSH client with saved connections, terminal, and SFTP",
      "desktop": {
        "entry": {
          "Name": "Custom SSH",
          "Comment": "SSH client with saved connections",
          "Categories": "Development;Network;",
          "StartupWMClass": "CustomSSH"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CustomSSH-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Custom SSH",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "CustomSSH-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CustomSSH-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GoblinThug",
        "repo": "Custom-SSH",
        "releaseType": "draft"
      }
    ]
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "ssh2@1.17.0": true,
    "esbuild@0.25.12": true
  }
}
